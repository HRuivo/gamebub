import { Global, Palette, ScreenId, Backend } from "../common.slint";
import { ScreenBase } from "../components/screen.slint";
import { ControlHint } from "../components/control_hint.slint";
import { HomeAction, HomeTile } from "../components/home_tile.slint";

enum HomeFocus {
    Cartridge,
    Cores,
    Tools,
    Settings,
}

global MainMenu {
    in-out property <HomeFocus> last-focus: Cartridge;
}

export component MainMenuScreen inherits ScreenBase {
    title: "Home";
    forward-focus: i-focus-scope;

    i-focus-scope := FocusScope {
        focus-changed-event => {
            if self.has-focus {
                if MainMenu.last-focus == HomeFocus.Cartridge {
                    tile-cartridge.focus();
                } else if MainMenu.last-focus == HomeFocus.Cores {
                    if Backend.sdcard-mounted {
                        tile-cores.focus();
                    } else {
                        MainMenu.last-focus = HomeFocus.Cartridge;
                        tile-cartridge.focus();
                    }
                } else if MainMenu.last-focus == HomeFocus.Tools {
                    action-tools.focus();
                } else {
                    action-settings.focus();
                }
            }
        }

        VerticalLayout {
            padding: 3px;
            spacing: 3px;

            Text {
                text: "Choose what to play";
                color: Palette.text;
                font-weight: 800;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                spacing: 5px;
                vertical-stretch: 1;

                tile-cartridge := HomeTile {
                    width: (parent.width - 5px) / 2;
                    title: "Cartridge";
                    icon-text: "GAME";
                    detail: "Play inserted game";
                    on-focused => { MainMenu.last-focus = HomeFocus.Cartridge; }
                    on-right => {
                        if Backend.sdcard-mounted { tile-cores.focus(); }
                        accept
                    }
                    on-down => { action-tools.focus(); accept }
                    on-pressed => { Backend.main-menu-run-cartridge(); }
                }

                tile-cores := HomeTile {
                    width: (parent.width - 5px) / 2;
                    title: Backend.sdcard-mounted ? "Cores" : "No microSD";
                    icon-text: "FPGA";
                    detail: Backend.sdcard-mounted ? "Browse installed cores" : "Insert a microSD card";
                    disabled: !Backend.sdcard-mounted;
                    on-focused => { MainMenu.last-focus = HomeFocus.Cores; }
                    on-left => { tile-cartridge.focus(); accept }
                    on-down => { action-settings.focus(); accept }
                    on-pressed => { Global.set-screen(ScreenId.Cores); }
                }
            }

            HorizontalLayout {
                spacing: 5px;

                Rectangle { horizontal-stretch: 1; background: transparent; }

                action-tools := HomeAction {
                    text: "TOOLS";
                    on-focused => { MainMenu.last-focus = HomeFocus.Tools; }
                    on-up => { tile-cartridge.focus(); accept }
                    on-right => { action-settings.focus(); accept }
                    on-pressed => { Global.set-screen(ScreenId.Tools); }
                }

                action-settings := HomeAction {
                    text: "SETTINGS";
                    on-focused => { MainMenu.last-focus = HomeFocus.Settings; }
                    on-up => {
                        if Backend.sdcard-mounted { tile-cores.focus(); } else { tile-cartridge.focus(); }
                        accept
                    }
                    on-left => { action-tools.focus(); accept }
                    on-pressed => { Global.set-screen(ScreenId.Settings); }
                }
            }

            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: Backend.sdcard-mounted ? "microSD ready" : "microSD unavailable";
                    color: Backend.sdcard-mounted ? Palette.accent-dark : Palette.danger;
                }

                ControlHint { label: "Select"; button: "a"; }
            }
        }
    }
}
