import { Palette } from "../common.slint";

export component HomeTile inherits Rectangle {
    callback on-up() -> EventResult;
    callback on-down() -> EventResult;
    callback on-left() -> EventResult;
    callback on-right() -> EventResult;
    callback on-pressed();
    callback on-focused();

    in property <string> title;
    in property <string> icon-text;
    in property <string> detail;
    in property <bool> disabled: false;

    background: focus.has-focus ? Palette.surface : Palette.surface-muted;
    border-color: focus.has-focus ? Palette.accent : Palette.disabled;
    border-width: focus.has-focus ? 3px : 1px;

    VerticalLayout {
        padding: 5px;
        spacing: 2px;

        Rectangle {
            background: root.disabled ? Palette.disabled : Palette.header;
            vertical-stretch: 1;

            Text {
                text: root.icon-text;
                color: Palette.text-on-dark;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Text {
            text: root.title;
            color: root.disabled ? Palette.disabled : Palette.text;
            font-weight: 800;
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.detail;
            color: Palette.text-muted;
            horizontal-alignment: center;
            overflow: elide;
            visible: !root.detail.is-empty;
        }
    }

    focus := FocusScope {
        enabled: !root.disabled;
        focus-changed-event => {
            if self.has-focus {
                root.on-focused();
            }
        }
        key-pressed(event) => {
            if event.text == "a" && !event.repeat {
                root.on-pressed();
                accept
            } else if event.text == Key.UpArrow {
                root.on-up()
            } else if event.text == Key.DownArrow {
                root.on-down()
            } else if event.text == Key.LeftArrow {
                root.on-left()
            } else if event.text == Key.RightArrow {
                root.on-right()
            } else {
                reject
            }
        }
    }

    forward-focus: focus;
}

export component HomeAction inherits Rectangle {
    callback on-up() -> EventResult;
    callback on-left() -> EventResult;
    callback on-right() -> EventResult;
    callback on-pressed();
    callback on-focused();

    in property <string> text;

    height: 22px;
    min-width: label.preferred-width + 16px;
    background: focus.has-focus ? Palette.surface : transparent;
    border-color: focus.has-focus ? Palette.accent : Palette.disabled;
    border-width: focus.has-focus ? 2px : 1px;

    label := Text {
        text: root.text;
        color: focus.has-focus ? Palette.text : Palette.text-muted;
        font-weight: focus.has-focus ? 800 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    focus := FocusScope {
        focus-changed-event => {
            if self.has-focus {
                root.on-focused();
            }
        }
        key-pressed(event) => {
            if event.text == "a" && !event.repeat {
                root.on-pressed();
                accept
            } else if event.text == Key.UpArrow {
                root.on-up()
            } else if event.text == Key.LeftArrow {
                root.on-left()
            } else if event.text == Key.RightArrow {
                root.on-right()
            } else {
                reject
            }
        }
    }

    forward-focus: focus;
}
